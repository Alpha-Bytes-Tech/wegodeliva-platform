# WeGoDeliva API — copy to .env for local development. Never commit .env.
# Staging/production values live in the hosting provider's secret store.

APP_NAME=WeGoDeliva
APP_ENV=local
APP_KEY=
# Must be false in staging and production (CLAUDE.md §4).
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres. Locally: docker compose (see README). On Supabase: use the pooled connection
# (port 6543) for the app and the direct connection (port 5432) for migrations; sslmode=require.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wegodeliva
DB_USERNAME=wegodeliva
DB_PASSWORD=wegodeliva
DB_SSLMODE=prefer

# API-only: no web sessions.
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail: Mailpit locally (http://localhost:8025). Staging/production: the transactional email
# provider chosen by the owner (open question S4).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@wegodeliva.com"
MAIL_FROM_NAME="${APP_NAME}"

# One-time codes (spec 13 "Authentication"). Defaults shown.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_PER_EMAIL_PER_HOUR=5
OTP_PER_IP_PER_HOUR=20

# Token lifetimes in minutes.
APP_TOKEN_LIFETIME_MINUTES=86400
ADMIN_TOKEN_LIFETIME_MINUTES=720

# Social sign-in: comma-separated OAuth client IDs (public identifiers, not secrets).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# First super admin, created by `php artisan db:seed`. Password: 12+ characters.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=
